# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Notebooks
.ipynb_checkpoints/
notebooks/**/*.nbconvert.ipynb

# Node / Promptfoo / Marp
node_modules/
.promptfoo/
slides/*.html
slides/*.pdf

# Eval outputs (the committed baseline is whitelisted below). This also keeps out
# reports/participant/ (each participant's Day 1–3 hand-off; references live in data/handoff/)
# and reports/day4/ (the capstone's summaries and review).
reports/*
!reports/baseline/
!reports/baseline/main.json

# Quarto site (built by `make site`, deployed by .github/workflows/pages.yml)
/_site/
/.quarto/
_freeze/

# Env / secrets
.env
.env.*
*.pem

# OS / editors
.DS_Store
.idea/
.vscode/

# Claude Code worktrees / local settings
.claude/
